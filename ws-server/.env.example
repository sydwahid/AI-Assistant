# ═══════════════════════════════════════════════════════════════════════
# QuickGPT WebSocket Server — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════

# Port — Render sets this automatically, defaults to 5000 locally
PORT=5000

# Frontend URL — set this in production for CORS
# Example: https://quickgpt.vercel.app
FRONTEND_URL=
